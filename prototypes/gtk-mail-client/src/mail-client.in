#!@PYTHON@

import os
import signal
import sys

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

if __name__ == '__main__':
    import gi

    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'mail-client.gresource'))
    resource._register()

    from mail_client import main

    sys.exit(main.main(VERSION))
