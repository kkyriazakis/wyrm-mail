<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kkyriazakis.WyrmMail</id>
  <launchable type="desktop-id">wyrm-mail.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Wyrm Mail</name>
  <summary>Outlook-first email client based on Thunderbird</summary>
  <description>
    <p>
      A native email client for Linux, based on Thunderbird. It connects to
      Microsoft 365 and Outlook accounts, including work accounts on custom
      domains, through Microsoft Graph, alongside Gmail and standard IMAP and
      SMTP accounts.
    </p>
  </description>
  <developer id="io.github.kkyriazakis">
    <name>Kleanthis Kyriazakis</name>
  </developer>
  <url type="homepage">https://github.com/kkyriazakis/wyrm-mail</url>
  <categories>
    <category>Network</category>
    <category>Email</category>
  </categories>
  <provides>
    <binary>wyrm-mail</binary>
    <mediatype>message/rfc822</mediatype>
    <mediatype>x-scheme-handler/mailto</mediatype>
    <mediatype>text/calendar</mediatype>
    <mediatype>text/vcard</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.1" date="2026-10-24"/>
    <release version="1.0.0" date="2026-10-22"/>
  </releases>
</component>
